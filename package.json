{
  "name": "school-email-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "School Email Scheduler — root package for repo-level tooling (E2E tests, etc.)",
  "scripts": {
    "test": "node --test tests/unit",
    "test:unit": "node --test tests/unit",
    "test:unit:coverage": "node --test --experimental-test-coverage tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e/playwright-report",
    "test:bdd": "bddgen --config=playwright-bdd.config.js && playwright test --config=playwright-bdd.config.js",
    "test:bdd:headed": "bddgen --config=playwright-bdd.config.js && playwright test --config=playwright-bdd.config.js --headed",
    "test:bdd:report": "playwright show-report tests/bdd/playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0",
    "playwright-bdd": "^7.5.0"
  }
}
